# ==========================================
# Dependencies and Package Managers
# ==========================================
# Blocks node_modules in the root (if any) and all subdirectories
**/node_modules/
# Blocks pnpm store/directories if used
**/.pnpm-store/

# ==========================================
# Docs used for RAG ingestion
# ==========================================
**/docs/

# ==========================================
# Environment Variables and Secrets
# ==========================================
# Never commit credentials or local configs
**/.env
**/.env.local
**/.env.*.local
**/@*

# ==========================================
# Build Outputs and Caches
# ==========================================
# Common build directories (e.g., Next.js, Vite, NestJS, TypeScript)
**/dist/
**/build/
**/.next/
**/.out/
**/.nuxt/
**/.cache/
**/.tsbuildinfo

# ==========================================
# Logs and Debugging
# ==========================================
**/logs
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*
**/.pnpm-debug.log*

# ==========================================
# Testing and Coverage
# ==========================================
**/coverage/
**/.nyc_output/

# ==========================================
# IDEs, Editors, and OS Files
# ==========================================
# System files
.DS_Store
Thumbs.db

# Editor configurations
**/.vscode/
**/.idea/
**/*.suo
**/*.ntvs*
**/*.njsproj
**/*.sln
**/*.sw?
